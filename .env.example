# Local defaults work without Google credentials. Copy this file to .env when needed.
STORAGE_DRIVER=file
PORT=8080
API_HOST=127.0.0.1
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Local development generates a private key in .data/admin-token if this is blank.
ADMIN_TOKEN=
# For Firestore development, use Application Default Credentials or an emulator.
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_COLLECTION_PREFIX=trip_helper
# Static frontend deployment; never put admin/invitation credentials in VITE_ variables.
VITE_API_BASE_URL=
VITE_BASE_PATH=./

# Verified larger variants of official Taipei photos; failure retries the original source.
VITE_IMAGE_VARIANT_HOST=www.travel.taipei
VITE_IMAGE_SOURCE_SIZE=640x480
VITE_IMAGE_DISPLAY_SIZE=1024x768
