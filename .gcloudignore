# Cloud Build receives only the Docker runtime inputs, never the local workspace.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!server/
!server/**/
!server/**/*.ts
!shared/
!shared/**/
!shared/**/*.ts
!public/
!public/trips/
!public/trips/**/
!public/trips/**/*.json
**/.data/**
**/.env
**/.env.*
**/test-results/**
**/playwright-report/**
**/admin-token
**/store.json
**/invites.json
**/*.test.ts
**/*.spec.ts
